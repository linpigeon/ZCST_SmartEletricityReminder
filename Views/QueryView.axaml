<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:WaterElectricityAutoClient.ViewModels"
             x:Class="WaterElectricityAutoClient.Views.QueryView"
             x:DataType="vm:QueryViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="房间查询" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBrush}"/>

            <!-- Input card -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="24"
                    BoxShadow="0 2 4 0 #14000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="学号查询" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeadingBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding Account}" Width="160" Height="34"
                                 PlaceholderText="请输入学号"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="保存学号" Command="{Binding SaveAccountCommand}"
                                Classes="default" Width="90" Height="34"/>
                        <Button Content="查询房间" Command="{Binding QueryRoomsCommand}"
                                Classes="accent" Width="90" Height="34"
                                IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="选择宿舍" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource LabelBrush}"/>
                        <ComboBox ItemsSource="{Binding Rooms}"
                                  SelectedItem="{Binding SelectedRoom}"
                                  Width="280" Height="34"
                                  IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RoomName}"/>
                                        <TextBlock Text="{Binding Odd, StringFormat='{}({0:F1}度)'}"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True" Height="3"
                                 IsVisible="{Binding IsLoading}"
                                 Foreground="{DynamicResource AccentBrush}" Background="Transparent"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Room detail card -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="24"
                    BoxShadow="0 2 4 0 #14000000"
                    IsVisible="{Binding SelectedRoom, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="房间详情" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeadingBrush}"/>

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="房间名称"
                                   Foreground="{DynamicResource LabelBrush}" FontSize="13"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedRoom.RoomName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ValueBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="当前余额"
                                   Foreground="{DynamicResource LabelBrush}" FontSize="13"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedRoom.Odd, StringFormat='{}{0:F2} 度'}"
                                   FontSize="14" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="累计用量"
                                   Foreground="{DynamicResource LabelBrush}" FontSize="13"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedRoom.Use, StringFormat='{}{0:F2} 度'}"
                                   FontSize="14" Foreground="{DynamicResource ValueBrush}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="校验码"
                                   Foreground="{DynamicResource LabelBrush}" FontSize="13"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding SelectedRoom.RoomVerify}"
                                   FontSize="14" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
