<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaterElectricityAutoClient.ViewModels"
        x:Class="WaterElectricityAutoClient.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="完美校园水电查询系统" Width="760" Height="540"
        MinWidth="580" MinHeight="420"
        Background="{DynamicResource ContentBrush}"
        Closing="OnWindowClosing">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ValueBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="56,*,Auto">
                <!-- Toggle button -->
                <Button Grid.Row="0"
                        Command="{Binding ToggleSidebarCommand}"
                        Background="Transparent"
                        Foreground="{DynamicResource TitleBrush}"
                        HorizontalAlignment="Stretch"
                        Content="≡" FontSize="22" FontWeight="Light"
                        Height="56" Padding="0" Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SidebarPressedBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- Nav items -->
                <ListBox Grid.Row="1"
                         SelectedIndex="{Binding SelectedNavIndex}"
                         Margin="0,4"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBoxItem>
                        <Grid ColumnDefinitions="36,*" Height="40" Margin="4,0">
                            <TextBlock Grid.Column="0" Text="&#x1F50D;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="查询"
                                       VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{DynamicResource ValueBrush}"
                                       Margin="6,0,0,0"
                                       IsVisible="{Binding IsSidebarExpanded}"/>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem>
                        <Grid ColumnDefinitions="36,*" Height="40" Margin="4,0">
                            <TextBlock Grid.Column="0" Text="&#x2699;"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="推送设置"
                                       VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{DynamicResource ValueBrush}"
                                       Margin="6,0,0,0"
                                       IsVisible="{Binding IsSidebarExpanded}"/>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Bottom area: theme toggle + version -->
                <StackPanel Grid.Row="2" Margin="4,4,4,8" Spacing="4">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Background="Transparent"
                            Height="36" Padding="8,0" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Grid ColumnDefinitions="36,*">
                            <TextBlock Grid.Column="0" Text="&#x2600;"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding IsDarkTheme}"/>
                            <TextBlock Grid.Column="0" Text="&#x1F319;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding IsDarkTheme, Converter={x:Static BoolConverters.Not}}"/>
                            <TextBlock Grid.Column="1" Text="深色模式"
                                       VerticalAlignment="Center" FontSize="13"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource LabelBrush}"
                                       IsVisible="{Binding IsSidebarExpanded}"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="水电查询 v1.0"
                               Foreground="{DynamicResource HintBrush}" FontSize="11"
                               Margin="12,0" IsVisible="{Binding IsSidebarExpanded}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBrush}">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>
